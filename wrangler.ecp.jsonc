{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurea-ecp-pilot",
  "main": "src/ecp/ecp-cloudflare-worker.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "ECP_EXPEDIENT_STATE", "class_name": "EcpExpedientStateDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EcpExpedientStateDurableObject"] }
  ],
  "vars": {
    "ECP_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_CLOUDFLARE_ACCESS_TEAM_NAME",
    "ECP_ACCESS_AUD": "REPLACE_WITH_CLOUDFLARE_ACCESS_APPLICATION_AUD",
    "ECP_ACCESS_ACTOR_ROLE": "ANALYST",
    "ECP_INSTITUTIONAL_INDEX_FILE_ID": "REPLACE_WITH_VERIFIED_CURRENT_INDEX_ID"
  },
  "secrets": {
    "required": ["ECP_GOOGLE_DRIVE_ACCESS_TOKEN"]
  }
}
