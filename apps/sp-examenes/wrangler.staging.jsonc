{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "sp-examenes-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    }
  ],
  "vars": {
    "SP_EXAMENES_MODEL": "gemini-3.8-flash"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SP_EXAMENES_LICENSES",
        "class_name": "SpExamenesLicenseDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sp-examenes-staging-licenses",
      "new_sqlite_classes": [
        "SpExamenesLicenseDurableObject"
      ]
    }
  ]
}
