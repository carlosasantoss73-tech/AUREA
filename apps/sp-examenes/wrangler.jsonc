{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "sp-examenes-pilot",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    }
  ],
  "vars": {
    "SP_EXAMENES_MODEL": "gemini-3.8-flash"
  }
}
